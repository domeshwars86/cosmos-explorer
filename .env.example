# Copy this file to .env and fill in real values. Never commit .env.

# development | production | testing
FLASK_ENV=development

# A long, random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value

# Port the dev server listens on (optional)
PORT=5000

# --- Space Intelligence (app/services/space_news_service.py, launch_service.py) ---
# Both external APIs (Spaceflight News API, Launch Library 2) are free and
# unauthenticated — no API key is required or read from the environment.

# Set to "false" to disable the Space Intelligence news feed entirely
# (Launches, ISRO, and Agencies pages keep working on their own static/curated
# data either way; only live news fetching is gated by this flag).
NEWS_API_ENABLED=true

# How long (in minutes) a fetched news page is cached before COSMOS asks
# the Spaceflight News API for a fresh one.
NEWS_CACHE_MINUTES=15

# How long (in minutes) upcoming-launch data is cached. Launch schedules
# change less often than news, so this is intentionally longer.
LAUNCH_CACHE_MINUTES=30
